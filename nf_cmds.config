// nf_cmds.config

conda.enabled = true
docker.enabled = true

process {
    withName: downloadSRA {
        conda = 'bioconda::entrez-direct=24.0 bioconda::sra-tools=3.2.1'
    }
    withName: convertSRA {
        conda = 'conda-forge::pigz=2.8 bioconda::sra-tools=3.2.1'
    }

    withName: cleanFastq {
        conda = 'bioconda::fastp=1.1.0'
    }

    withName: assembleGenome {
        conda = 'bioconda::skesa=2.5.1'
    }

    withName: fastqMetrics {
        conda = 'bioconda::seqkit=2.13.0'
    }

    withName: filterContigs {
        conda = 'conda-forge::biopython=1.87'
    }

    withName: genePrediction {
        conda = 'bioconda::prodigal=2.6.3'
    }

    withName: extract16S {
        conda = 'bioconda::barrnap=0.9 bioconda::bedtools=2.31.1'
    }

    withName: genusIdentification {
        conda = 'bioconda::blast=2.16.0 conda-forge::biopython=1.87'
    }

    withName: readGenusIdentification {
        conda = 'conda-forge::biopython=1.87 conda-forge::pandas=3.0.3'
    }

    withName: mashIdentification {
        conda = 'bioconda::mash=2.3'
    }

    withName: readMashIdentification {
        conda = 'conda-forge::pandas=3.0.3'
    }

    withName: genotyping {
        conda = 'bioconda::mlst=2.32.2'
    }

    withName: genomeQA {
        conda = 'bioconda::busco=6.0.0'
    }

    withName: contigQA {
        conda = 'bioconda::gunc=1.1.0'
    }

    // phylogeneticAnalysis (parsnp) has no native osx-arm64 conda build, so it
    // runs via Docker instead (container/containerOptions set in nf_cmds.nf)

    withName: renderPhylogeneticTree {
        conda = 'bioconda::figtree=1.4.4'
    }

    withName: summarizeResults {
        conda = 'conda-forge::pandas=3.0.3'
    }
}
